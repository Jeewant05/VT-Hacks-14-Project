      "Workstream": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "objective_id": {
            "type": "string",
            "title": "Objective Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "agent_id": {
            "type": "string",
            "title": "Agent Id"
          },
          "owned_paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Owned Paths"
          },
          "depends_on": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Depends On"
